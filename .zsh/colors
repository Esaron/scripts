#!/bin/zsh

# ANSI color codes for zsh
# format:       %F{color} or %{escape_sequence%}
# In zsh, use %{...%} to wrap non-printing characters
# Foreground colors: (30-37)
# Background colors: (40-47)
# Attributes:
#   0 = normal
#   1 = bold
#   4 = underline
#   5 = blink
#   7 = invert
#   8 = invisible

# Foreground colors - zsh format with %{...%} wrapping
LBLACK="%{$(printf '\033[0;30m')%}"
BLACK="%{$(printf '\033[1;30m')%}"
LRED="%{$(printf '\033[0;31m')%}"
RED="%{$(printf '\033[1;31m')%}"
REDRAW="$(printf '\033[1;31m')"
LGREEN="%{$(printf '\033[0;32m')%}"
GREEN="%{$(printf '\033[1;32m')%}"
LYELLOW="%{$(printf '\033[0;33m')%}"
LYELLOWRAW="$(printf '\033[0;33m')"
YELLOW="%{$(printf '\033[1;33m')%}"
LBLUE="%{$(printf '\033[0;34m')%}"
LBLUERAW="$(printf '\033[0;34m')"
BLUE="%{$(printf '\033[1;34m')%}"
BLUERAW="$(printf '\033[1;34m')"
LMAGENTA="%{$(printf '\033[0;35m')%}"
LMAGENTARAW="$(printf '\033[0;35m')"
MAGENTA="%{$(printf '\033[1;35m')%}"
LCYAN="%{$(printf '\033[0;36m')%}"
CYAN="%{$(printf '\033[1;36m')%}"
LWHITE="%{$(printf '\033[0;37m')%}"
LWHITERAW="$(printf '\033[0;37m')"
WHITE="%{$(printf '\033[1;37m')%}"
COLOR_OFF="%{$(printf '\033[m')%}"

# Alternative modern zsh approach using built-in color support
